{
  "name": "scrum-poker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mesa de Planning Poker en tiempo real para puntuar historias de usuario (frontend, sin backend).",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_TRANSPORT=local vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.500.0",
    "nanoid": "^5.0.0",
    "peerjs": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
